# Copie este arquivo para 'secrets.toml' e preencha com as credenciais reais.
# O arquivo secrets.toml NÃO deve ser versionado no Git.

[api]
# URL base da API de Credit Score (sem barra no final)
base_url = "http://localhost:8000"

# Chave de API padrão (opcional - pode ser sobrescrita na sidebar)
default_api_key = ""

# Timeout em segundos para requisições
timeout = 30
