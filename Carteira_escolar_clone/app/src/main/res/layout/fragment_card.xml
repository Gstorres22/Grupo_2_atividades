<?xml version="1.0" encoding="utf-8"?>
<!-- Tela inicial: barra de acoes + carteirinha -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <!-- Girar e QR Code a esquerda, compartilhar a direita -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/action_row_margin_top"
        android:paddingStart="13dp"
        android:paddingEnd="13dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_flip"
                style="@style/CardActionButton"
                android:contentDescription="@string/action_flip"
                android:padding="8dp"
                android:src="@drawable/ic_rotate_card" />

            <ImageButton
                android:id="@+id/btn_qr"
                style="@style/CardActionButton"
                android:contentDescription="@string/action_qr"
                android:padding="7dp"
                android:src="@drawable/ic_qr_code" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_share"
            style="@style/CardActionButton"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/action_share"
            android:padding="8dp"
            android:src="@drawable/ic_share" />
    </FrameLayout>

    <!--
      "Palco" da carteirinha: recebe o cartao deitado (534x306dp), gira 90 graus
      e escala para caber no espaco disponivel, sem deformar.
    -->
    <com.example.clone_carterinha_digital.widget.CardStageLayout
        android:id="@+id/card_stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/stage_padding_horizontal"
        android:paddingTop="44dp"
        android:paddingEnd="@dimen/stage_padding_horizontal"
        android:paddingBottom="60dp">

        <FrameLayout
            android:id="@+id/card_container"
            android:layout_width="@dimen/card_design_width"
            android:layout_height="@dimen/card_design_height">

            <include
                android:id="@+id/card_front"
                layout="@layout/view_card_front" />

            <include
                android:id="@+id/card_back"
                layout="@layout/view_card_back" />
        </FrameLayout>
    </com.example.clone_carterinha_digital.widget.CardStageLayout>
</LinearLayout>
