# =============================================================================
# Modelo de configuracao — copie para `App/.env` e preencha com suas credenciais.
#
# IMPORTANTE: `.env` esta no .gitignore e NUNCA deve ser versionado.
# Este arquivo (`.env.example`) e versionado de proposito, mas SEM valores reais.
#
# O nucleo do case (candidate_starter/) NAO le este arquivo e roda 100% offline.
# Estas variaveis so afetam a camada de aplicacao em App/ (cascata, embeddings,
# judge). Sem chave, tudo degrada automaticamente para o modo local.
# =============================================================================

# --- OpenAI ---
OPENAI_API_KEY=

# Modelo pequeno usado APENAS no escalonamento (rerank de tools ambiguas e
# desempate do router). Escolhido por ser barato: so roda em ~poucos % das queries.
OPENAI_MODEL_SMALL=gpt-4o-mini

# Modelo usado como juiz na avaliacao (LLM-as-judge). Roda offline do fluxo,
# so na etapa de eval, entao pode ser um pouco mais caro/capaz.
OPENAI_MODEL_JUDGE=gpt-4o-mini

# Embeddings do catalogo de tools. Sao gerados UMA vez para as 285 tools e
# persistidos em App/cache/ — custo praticamente nulo (~US$ 0,0002).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Chaves de comportamento da cascata ---
# Liga/desliga o uso de OpenAI no fluxo. "false" = pipeline 100% local.
ENABLE_LLM_ESCALATION=true

# Router: se a confianca do classificador local ficar ABAIXO deste valor,
# escalamos para o LLM desempatar. 0.65 e o ponto de partida; sera calibrado
# pela curva cobertura x acuracia no notebook 04.
ROUTER_CONFIDENCE_THRESHOLD=0.65

# Retriever: se a margem entre o 1o e o 2o colocado for MENOR que isto, a query
# e considerada ambigua e vai para o rerank por LLM.
RETRIEVER_MARGIN_THRESHOLD=0.05

# =============================================================================
# V1.0.1 — Orquestrador por LLM
# =============================================================================
# Modelo que substitui o classificador local na V1.0.1. Roda em TODA mensagem,
# entao latencia e custo por chamada sao as restricoes dominantes.
# (A definir com base na pesquisa de custos — ver V1_0_1_DECISIONS.md)
OPENAI_MODEL_ORCHESTRATOR=gpt-5.6-luna

# =============================================================================
# V1.0.1. Ele so roda os subagentes que TESTAM o sistema. Avaliador e avaliado
# usam provedores diferentes de proposito: se compartilhassem infraestrutura,
# uma falha comum aos dois passaria despercebida.
#

# =============================================================================
# Subagentes de teste (personas e avaliadores)
# =============================================================================
# Modelo usado pelos subagentes que TESTAM o sistema. Deliberadamente DIFERENTE
# do orquestrador: quem avalia nao deve ser o mesmo modelo que e avaliado.
# LLMs tendem a preferir as proprias saidas (vies de auto-preferencia), o que
# inflaria a nota. Roda offline, entao vale usar um modelo mais capaz.
OPENAI_MODEL_AGENTS=gpt-5.6-sol

# Quanto o orquestrador deve "pensar" antes de responder: none/low/medium/high.
# So se aplica a modelos de raciocinio (familia GPT-5, serie o). O default de
# FABRICA da familia 5.6 e "medium" — medimos 23 tokens de raciocinio cobrados
# por chamada, sem ganho de acerto numa tarefa de classificacao.
ORCHESTRATOR_REASONING_EFFORT=none
