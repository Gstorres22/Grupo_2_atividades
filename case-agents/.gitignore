__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# O relatorio gerado pelo run_case.py e o ENTREGAVEL Nº 2 do case, entao
# precisa estar no repositorio. A regra original ignorava `reports/` inteiro;
# aqui ignoramos o conteudo da pasta MENOS o relatorio.
reports/*
!reports/candidate_report.json
*.egg-info/
.DS_Store

# --- Credenciais: NUNCA versionar ---
.env
.env.*
!.env.example

# --- Camada de aplicacao (App/) ---
App/cache/
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Relatorios dos subagentes: SAO versionados de proposito ---
# A regra `reports/` da linha 5 (do case original) tambem pegava App/reports/.
# Mas esses relatorios sao entregavel: registram o que as personas geraram e o
# que os avaliadores concluiram, e sem eles as conclusoes da V1.0.1 nao teriam
# como ser conferidas por outra pessoa. A excecao abaixo os traz de volta.
!App/reports/
!App/reports/**

# Os logs brutos de execucao nao: sao ruido de terminal, regeneraveis a cada
# rodada. Os JSON de relatorio, sim — eles sao o registro do experimento.
App/reports/*_log.txt
